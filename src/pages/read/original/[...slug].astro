---
import { getCollection, render } from 'astro:content';
import ReaderLayout from '../../../layouts/ReaderLayout.astro';

export async function getStaticPaths() {
  const chapters = await getCollection('original');
  const sorted = [...chapters].sort((a, b) => a.data.chapter - b.data.chapter);

  return sorted.map((entry, i) => ({
    params: { slug: entry.data.slug },
    props: {
      entry,
      prevChapter: i > 0
        ? { slug: sorted[i - 1].data.slug, title: sorted[i - 1].data.title, chapter: sorted[i - 1].data.chapter }
        : null,
      nextChapter: i < sorted.length - 1
        ? { slug: sorted[i + 1].data.slug, title: sorted[i + 1].data.title, chapter: sorted[i + 1].data.chapter }
        : null,
      allChapters: sorted.map((c) => ({
        slug: c.data.slug,
        title: c.data.title,
        chapter: c.data.chapter,
      })),
    },
  }));
}

const { entry, prevChapter, nextChapter, allChapters } = Astro.props;
const { Content } = await render(entry);
---

<ReaderLayout
  title={entry.data.title}
  bookTitle="The Society of Mind"
  chapterSlug={entry.data.slug}
  mode="original"
  prevChapter={prevChapter}
  nextChapter={nextChapter}
  allChapters={allChapters}
>
  <article class="original-prose">
    <Content />
  </article>
</ReaderLayout>

<style>
  .original-prose {
    max-width: 65ch;
    margin: 0 auto;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.2rem;
    line-height: 1.9;
    color: #e0e0e0;
  }

  .original-prose :global(h1) {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: #fff;
  }

  .original-prose :global(h2) {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: #fff;
  }

  .original-prose :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: #f0f0f0;
  }

  .original-prose :global(p) {
    margin-bottom: 1.25rem;
    text-indent: 1.5em;
  }

  .original-prose :global(p:first-of-type) {
    text-indent: 0;
  }

  .original-prose :global(blockquote) {
    border-left: 3px solid #64b5f6;
    padding: 0.5rem 1rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: #bbb;
    background: rgba(100, 181, 246, 0.04);
    border-radius: 0 0.375rem 0.375rem 0;
  }

  .original-prose :global(code) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9em;
    background: rgba(255, 255, 255, 0.06);
    padding: 0.15em 0.35em;
    border-radius: 4px;
  }
</style>
