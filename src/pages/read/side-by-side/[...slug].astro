---
import { getCollection, render } from 'astro:content';
import ReaderLayout from '../../../layouts/ReaderLayout.astro';

export async function getStaticPaths() {
  const chapters = await getCollection('original');
  const docs = await getCollection('docs');
  const sorted = [...chapters].sort((a, b) => a.data.chapter - b.data.chapter);

  return sorted.map((entry, i) => {
    const slug = entry.data.slug;

    // Find matching companion docs whose id starts with "chapters/<slug>"
    const companionDocs = docs.filter((d) => d.id.startsWith(`chapters/${slug}`));
    // Pick the overview page if available, otherwise the first match
    const companionEntry =
      companionDocs.find((d) => d.id.includes('overview')) ??
      companionDocs[0] ??
      null;

    return {
      params: { slug },
      props: {
        entry,
        companionEntry,
        prevChapter:
          i > 0
            ? { slug: sorted[i - 1].data.slug, title: sorted[i - 1].data.title, chapter: sorted[i - 1].data.chapter }
            : null,
        nextChapter:
          i < sorted.length - 1
            ? { slug: sorted[i + 1].data.slug, title: sorted[i + 1].data.title, chapter: sorted[i + 1].data.chapter }
            : null,
        allChapters: sorted.map((c) => ({
          slug: c.data.slug,
          title: c.data.title,
          chapter: c.data.chapter,
        })),
      },
    };
  });
}

const { entry, companionEntry, prevChapter, nextChapter, allChapters } = Astro.props;
const { Content: OriginalContent } = await render(entry);
const CompanionContent = companionEntry ? (await render(companionEntry)).Content : null;
---

<ReaderLayout
  title={entry.data.title}
  bookTitle="The Society of Mind"
  chapterSlug={entry.data.slug}
  mode="side-by-side"
  prevChapter={prevChapter}
  nextChapter={nextChapter}
  allChapters={allChapters}
>
  <!-- Mobile tab toggle (visible < 768px) -->
  <div class="mobile-tabs">
    <button class="mobile-tab active" data-panel="original">Original</button>
    <button class="mobile-tab" data-panel="companion">Companion</button>
  </div>

  <div class="split-container" id="split-container">
    <!-- Left: original text -->
    <div class="panel panel-original" id="panel-original">
      <article class="panel-inner original-prose">
        <OriginalContent />
      </article>
    </div>

    <!-- Draggable divider -->
    <div class="divider" id="split-divider"></div>

    <!-- Right: companion content -->
    <div class="panel panel-companion" id="panel-companion">
      <article class="panel-inner companion-prose">
        {CompanionContent ? (
          <CompanionContent />
        ) : (
          <div class="companion-placeholder">
            <p>Companion content for this chapter is not yet available.</p>
            <p>Check back soon or view the <a href={`/chapters/${entry.data.slug}/overview/`}>companion overview</a>.</p>
          </div>
        )}
      </article>
    </div>
  </div>
</ReaderLayout>

<style>
  /* ---- Mobile tabs ---- */
  .mobile-tabs {
    display: none;
    gap: 0;
    margin-bottom: 1rem;
    border: 1px solid var(--reader-border, #232328);
    border-radius: 8px;
    overflow: hidden;
  }

  .mobile-tab {
    flex: 1;
    padding: 0.6rem 1rem;
    border: none;
    background: transparent;
    color: var(--reader-text-muted, #888);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }

  .mobile-tab.active {
    background: var(--reader-accent, #64b5f6);
    color: #000;
    font-weight: 600;
  }

  /* ---- Split container ---- */
  .split-container {
    display: grid;
    grid-template-columns: 1fr 4px 1fr;
    min-height: calc(100vh - var(--reader-topbar-h, 60px) - var(--reader-footer-h, 50px) - 5rem);
    gap: 0;
  }

  /* ---- Panels ---- */
  .panel {
    overflow-y: auto;
    padding: 1.5rem;
  }

  .panel-original {
    background: #0a0a0b;
  }

  .panel-companion {
    background: #111113;
  }

  .panel-inner {
    max-width: 70ch;
    margin: 0 auto;
  }

  /* ---- Original prose styling ---- */
  .original-prose {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.1rem;
    line-height: 1.85;
    color: #e0e0e0;
  }

  .original-prose :global(h1) {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
    color: #fff;
  }

  .original-prose :global(h2) {
    font-size: 1.35rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: #fff;
  }

  .original-prose :global(p) {
    margin-bottom: 1rem;
    text-indent: 1.5em;
  }

  .original-prose :global(p:first-of-type) {
    text-indent: 0;
  }

  .original-prose :global(blockquote) {
    border-left: 3px solid #64b5f6;
    padding: 0.5rem 1rem;
    margin: 1.25rem 0;
    font-style: italic;
    color: #bbb;
    background: rgba(100, 181, 246, 0.04);
    border-radius: 0 0.375rem 0.375rem 0;
  }

  /* ---- Companion prose styling ---- */
  .companion-prose {
    font-family: 'Instrument Sans', system-ui, sans-serif;
    font-size: 0.95rem;
    line-height: 1.7;
    color: #d0d0d0;
  }

  .companion-prose :global(h1) {
    font-size: 1.6rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: #fff;
  }

  .companion-prose :global(h2) {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    color: #f0f0f0;
  }

  .companion-prose :global(p) {
    margin-bottom: 0.9rem;
  }

  .companion-prose :global(code) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85em;
    background: rgba(255, 255, 255, 0.06);
    padding: 0.15em 0.35em;
    border-radius: 4px;
  }

  /* ---- Companion placeholder ---- */
  .companion-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 40vh;
    text-align: center;
    color: var(--reader-text-muted, #888);
    font-size: 0.95rem;
  }

  .companion-placeholder a {
    color: var(--reader-accent, #64b5f6);
  }

  /* ---- Divider ---- */
  .divider {
    background: var(--reader-border, #232328);
    cursor: col-resize;
    position: relative;
    z-index: 10;
    transition: background 0.15s;
  }

  .divider:hover,
  .divider.dragging {
    background: var(--reader-accent, #64b5f6);
  }

  /* ---- Responsive: below 768px ---- */
  @media (max-width: 768px) {
    .mobile-tabs {
      display: flex;
    }

    .split-container {
      display: block;
    }

    .divider {
      display: none;
    }

    .panel {
      display: none;
    }

    .panel.visible {
      display: block;
    }

    .panel-original.visible,
    .panel-companion.visible {
      background: transparent;
    }
  }
</style>

<script>
  // ===== Draggable divider =====
  const container = document.getElementById('split-container');
  const divider = document.getElementById('split-divider');

  if (container && divider) {
    let isDragging = false;

    function onPointerDown(e: MouseEvent | TouchEvent) {
      isDragging = true;
      divider!.classList.add('dragging');
      document.body.style.cursor = 'col-resize';
      document.body.style.userSelect = 'none';
      e.preventDefault();
    }

    function onPointerMove(e: MouseEvent | TouchEvent) {
      if (!isDragging) return;
      const rect = container!.getBoundingClientRect();
      const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      let pct = ((clientX - rect.left) / rect.width) * 100;
      pct = Math.max(20, Math.min(80, pct));
      container!.style.gridTemplateColumns = `${pct}% 4px ${100 - pct}%`;
    }

    function onPointerUp() {
      if (!isDragging) return;
      isDragging = false;
      divider!.classList.remove('dragging');
      document.body.style.cursor = '';
      document.body.style.userSelect = '';
    }

    divider.addEventListener('mousedown', onPointerDown);
    document.addEventListener('mousemove', onPointerMove);
    document.addEventListener('mouseup', onPointerUp);

    divider.addEventListener('touchstart', onPointerDown, { passive: false });
    document.addEventListener('touchmove', onPointerMove, { passive: false });
    document.addEventListener('touchend', onPointerUp);
  }

  // ===== Mobile tab toggle =====
  const tabs = document.querySelectorAll<HTMLButtonElement>('.mobile-tab');
  const panelOriginal = document.getElementById('panel-original');
  const panelCompanion = document.getElementById('panel-companion');

  if (tabs.length && panelOriginal && panelCompanion) {
    // Default: show original
    panelOriginal.classList.add('visible');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');

        const target = tab.dataset.panel;
        if (target === 'original') {
          panelOriginal.classList.add('visible');
          panelCompanion.classList.remove('visible');
        } else {
          panelCompanion.classList.add('visible');
          panelOriginal.classList.remove('visible');
        }
      });
    });
  }
</script>
