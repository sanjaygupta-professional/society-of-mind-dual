---
// Custom landing page for The Society of Mind dual companion
// This is a standalone HTML page, not using Starlight's layout
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The Society of Mind — Dual Learning Companion</title>
  <meta name="description" content="A dual-reader learning companion for The Society of Mind by Marvin Minsky. Read the original text side-by-side with visual diagrams, concept maps, and guided learning paths." />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <style>
    /* ============================================
       CSS VARIABLES
       ============================================ */
    :root {
      /* Neural / Cognitive palette */
      --neural-blue: #64b5f6;
      --synaptic-purple: #ce93d8;
      --emergent-green: #81c784;
      --memory-amber: #ffd54f;
      --conflict-red: #ef9a9a;
      --accent: #64b5f6;

      /* Backgrounds */
      --bg-dark: #0a0a0b;
      --bg-section: #111113;
      --bg-card: #18181b;
      --bg-card-hover: #1e1e22;

      /* Text */
      --text-primary: #f0f0f2;
      --text-secondary: #a0a0a8;
      --text-muted: #6b6b75;

      /* Borders */
      --border-subtle: rgba(255, 255, 255, 0.06);
      --border-hover: rgba(255, 255, 255, 0.12);

      /* Typography */
      --font-display: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
      --font-body: 'Instrument Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --font-mono: 'JetBrains Mono', 'Fira Code', monospace;

      /* Spacing */
      --section-padding: 6rem 2rem;
      --container-max: 1200px;
      --card-radius: 12px;
    }

    /* ============================================
       RESET & BASE
       ============================================ */
    *, *::before, *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    body {
      font-family: var(--font-body);
      background: var(--bg-dark);
      color: var(--text-primary);
      line-height: 1.7;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img { max-width: 100%; }

    .container {
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* ============================================
       FADE-IN SCROLL ANIMATIONS
       ============================================ */
    .fade-in {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.8s ease, transform 0.8s ease;
    }

    .fade-in.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .fade-in-delay-1 { transition-delay: 0.1s; }
    .fade-in-delay-2 { transition-delay: 0.2s; }
    .fade-in-delay-3 { transition-delay: 0.3s; }
    .fade-in-delay-4 { transition-delay: 0.4s; }
    .fade-in-delay-5 { transition-delay: 0.5s; }
    .fade-in-delay-6 { transition-delay: 0.6s; }
    .fade-in-delay-7 { transition-delay: 0.7s; }
    .fade-in-delay-8 { transition-delay: 0.8s; }

    /* ============================================
       SECTION STYLES
       ============================================ */
    .section {
      padding: var(--section-padding);
      position: relative;
    }

    .section-dark {
      background: var(--bg-section);
    }

    .section-title {
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 3rem);
      font-weight: 600;
      text-align: center;
      margin-bottom: 1rem;
      color: var(--text-primary);
      letter-spacing: -0.02em;
    }

    .section-subtitle {
      text-align: center;
      color: var(--text-secondary);
      font-size: 1.125rem;
      max-width: 640px;
      margin: 0 auto 3.5rem;
      line-height: 1.8;
    }

    /* ============================================
       HERO SECTION
       ============================================ */
    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      padding: 4rem 2rem;
      overflow: hidden;
    }

    /* SVG network background */
    .hero-network {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      opacity: 0.35;
    }

    .hero-network circle {
      fill: none;
      stroke-width: 1.5;
    }

    .hero-network line {
      stroke: rgba(100, 181, 246, 0.15);
      stroke-width: 0.75;
    }

    /* Node pulses */
    @keyframes nodePulse1 {
      0%, 100% { r: 3; opacity: 0.5; }
      50% { r: 5; opacity: 1; }
    }
    @keyframes nodePulse2 {
      0%, 100% { r: 2.5; opacity: 0.4; }
      50% { r: 4.5; opacity: 0.9; }
    }
    @keyframes nodePulse3 {
      0%, 100% { r: 3.5; opacity: 0.45; }
      50% { r: 5.5; opacity: 0.95; }
    }

    .node-blue {
      stroke: var(--neural-blue);
      animation: nodePulse1 4s ease-in-out infinite;
    }
    .node-purple {
      stroke: var(--synaptic-purple);
      animation: nodePulse2 5s ease-in-out infinite;
    }
    .node-green {
      stroke: var(--emergent-green);
      animation: nodePulse3 6s ease-in-out infinite;
    }
    .node-amber {
      stroke: var(--memory-amber);
      animation: nodePulse1 5.5s ease-in-out infinite;
    }
    .node-red {
      stroke: var(--conflict-red);
      animation: nodePulse2 4.5s ease-in-out infinite;
    }

    /* Float animation for nodes */
    @keyframes float1 {
      0%, 100% { transform: translate(0, 0); }
      25% { transform: translate(4px, -6px); }
      50% { transform: translate(-3px, 4px); }
      75% { transform: translate(5px, 2px); }
    }
    @keyframes float2 {
      0%, 100% { transform: translate(0, 0); }
      25% { transform: translate(-5px, 3px); }
      50% { transform: translate(4px, -5px); }
      75% { transform: translate(-2px, 6px); }
    }
    @keyframes float3 {
      0%, 100% { transform: translate(0, 0); }
      25% { transform: translate(3px, 5px); }
      50% { transform: translate(-6px, -3px); }
      75% { transform: translate(4px, -4px); }
    }

    .float-group-1 { animation: float1 12s ease-in-out infinite; }
    .float-group-2 { animation: float2 14s ease-in-out infinite; }
    .float-group-3 { animation: float3 16s ease-in-out infinite; }

    /* Gradient overlays */
    .hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: radial-gradient(ellipse at 30% 20%, rgba(100, 181, 246, 0.08) 0%, transparent 60%),
                  radial-gradient(ellipse at 70% 60%, rgba(206, 147, 216, 0.06) 0%, transparent 50%),
                  radial-gradient(ellipse at 50% 80%, rgba(129, 199, 132, 0.05) 0%, transparent 40%);
      z-index: 1;
      pointer-events: none;
    }

    .hero-content {
      text-align: center;
      position: relative;
      z-index: 2;
      max-width: 800px;
    }

    .hero-badge {
      display: inline-block;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      color: var(--neural-blue);
      background: rgba(100, 181, 246, 0.1);
      border: 1px solid rgba(100, 181, 246, 0.2);
      padding: 0.5rem 1.25rem;
      border-radius: 100px;
      margin-bottom: 2rem;
    }

    .hero-title {
      font-family: var(--font-display);
      font-size: clamp(3rem, 7vw, 5.5rem);
      font-weight: 700;
      line-height: 1.05;
      letter-spacing: -0.03em;
      margin-bottom: 1.5rem;
      background: linear-gradient(135deg, var(--text-primary) 0%, var(--neural-blue) 50%, var(--synaptic-purple) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .hero-quote {
      font-family: var(--font-display);
      font-size: clamp(1.125rem, 2.5vw, 1.5rem);
      font-style: italic;
      color: var(--text-secondary);
      line-height: 1.6;
      margin-bottom: 0.75rem;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }

    .hero-attribution {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--text-muted);
      letter-spacing: 0.05em;
      margin-bottom: 3rem;
    }

    .hero-buttons {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.875rem 2rem;
      border-radius: 100px;
      font-family: var(--font-body);
      font-size: 0.95rem;
      font-weight: 600;
      transition: all 0.3s ease;
      cursor: pointer;
      border: none;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--neural-blue), #42a5f5);
      color: #0a0a0b;
      box-shadow: 0 4px 20px rgba(100, 181, 246, 0.3);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(100, 181, 246, 0.45);
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.06);
      color: var(--text-primary);
      border: 1px solid var(--border-hover);
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: var(--neural-blue);
      transform: translateY(-2px);
    }

    /* ============================================
       READING MODES
       ============================================ */
    .modes-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5rem;
      max-width: var(--container-max);
      margin: 0 auto;
    }

    .mode-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--card-radius);
      padding: 2.25rem;
      transition: all 0.35s ease;
      display: flex;
      flex-direction: column;
      position: relative;
      overflow: hidden;
    }

    .mode-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      opacity: 0;
      transition: opacity 0.35s ease;
    }

    .mode-card:hover {
      border-color: var(--border-hover);
      background: var(--bg-card-hover);
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
    }

    .mode-card:hover::before {
      opacity: 1;
    }

    .mode-original::before { background: linear-gradient(90deg, var(--neural-blue), var(--synaptic-purple)); }
    .mode-companion::before { background: linear-gradient(90deg, var(--emergent-green), var(--memory-amber)); }
    .mode-sidebyside::before { background: linear-gradient(90deg, var(--synaptic-purple), var(--neural-blue)); }

    .mode-icon {
      font-size: 2.5rem;
      margin-bottom: 1.25rem;
      line-height: 1;
    }

    .mode-card h3 {
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
      color: var(--text-primary);
    }

    .mode-card p {
      color: var(--text-secondary);
      font-size: 0.95rem;
      line-height: 1.7;
      flex-grow: 1;
      margin-bottom: 1.5rem;
    }

    .mode-link {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--neural-blue);
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      transition: gap 0.3s ease;
    }

    .mode-card:hover .mode-link {
      gap: 0.7rem;
    }

    /* ============================================
       JOURNEY / PARTS
       ============================================ */
    .parts-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1.25rem;
      max-width: var(--container-max);
      margin: 0 auto;
    }

    .part-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--card-radius);
      padding: 2rem;
      transition: all 0.35s ease;
      display: flex;
      gap: 1.25rem;
      align-items: flex-start;
    }

    .part-card:hover {
      border-color: var(--border-hover);
      background: var(--bg-card-hover);
      transform: translateY(-2px);
    }

    .part-number {
      font-family: var(--font-display);
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--neural-blue);
      line-height: 1;
      min-width: 3rem;
      opacity: 0.7;
    }

    .part-info h3 {
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 0.25rem;
      color: var(--text-primary);
    }

    .part-chapters {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--text-muted);
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-bottom: 0.5rem;
    }

    .part-info p {
      color: var(--text-secondary);
      font-size: 0.9rem;
      line-height: 1.6;
    }

    /* ============================================
       CORE CONCEPTS
       ============================================ */
    .concepts-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.25rem;
      max-width: var(--container-max);
      margin: 0 auto;
    }

    .concept-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--card-radius);
      padding: 1.75rem;
      transition: all 0.35s ease;
    }

    .concept-card:hover {
      border-color: var(--border-hover);
      background: var(--bg-card-hover);
      transform: translateY(-3px);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
    }

    .concept-icon {
      font-size: 1.75rem;
      margin-bottom: 0.75rem;
      line-height: 1;
    }

    .concept-card h3 {
      font-family: var(--font-display);
      font-size: 1.2rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
      color: var(--text-primary);
    }

    .concept-card p {
      color: var(--text-secondary);
      font-size: 0.88rem;
      line-height: 1.6;
    }

    /* ============================================
       LEARNING PATHS
       ============================================ */
    .paths-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1.5rem;
      max-width: var(--container-max);
      margin: 0 auto;
    }

    .path-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--card-radius);
      padding: 2.25rem;
      transition: all 0.35s ease;
      position: relative;
      overflow: hidden;
    }

    .path-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
    }

    .path-card:hover {
      border-color: var(--border-hover);
      background: var(--bg-card-hover);
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
    }

    .path-beginner::before { background: linear-gradient(90deg, var(--emergent-green), var(--neural-blue)); }
    .path-intermediate::before { background: linear-gradient(90deg, var(--memory-amber), var(--synaptic-purple)); }
    .path-advanced::before { background: linear-gradient(90deg, var(--conflict-red), var(--memory-amber)); }

    .path-level {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      margin-bottom: 0.75rem;
    }

    .path-beginner .path-level { color: var(--emergent-green); }
    .path-intermediate .path-level { color: var(--memory-amber); }
    .path-advanced .path-level { color: var(--conflict-red); }

    .path-card h3 {
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
      color: var(--text-primary);
    }

    .path-card p {
      color: var(--text-secondary);
      font-size: 0.95rem;
      line-height: 1.7;
      margin-bottom: 1.25rem;
    }

    .path-meta {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--text-muted);
      letter-spacing: 0.03em;
      padding-top: 1rem;
      border-top: 1px solid var(--border-subtle);
    }

    /* ============================================
       FINAL CTA
       ============================================ */
    .cta-section {
      text-align: center;
      padding: 8rem 2rem;
      position: relative;
    }

    .cta-section::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: radial-gradient(ellipse at 50% 50%, rgba(100, 181, 246, 0.06) 0%, transparent 70%);
      pointer-events: none;
    }

    .cta-title {
      font-family: var(--font-display);
      font-size: clamp(2.25rem, 5vw, 3.5rem);
      font-weight: 700;
      margin-bottom: 1rem;
      letter-spacing: -0.02em;
      background: linear-gradient(135deg, var(--text-primary) 0%, var(--neural-blue) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .cta-subtitle {
      font-size: 1.125rem;
      color: var(--text-secondary);
      margin-bottom: 2.5rem;
      max-width: 500px;
      margin-left: auto;
      margin-right: auto;
    }

    /* ============================================
       FOOTER
       ============================================ */
    .site-footer {
      border-top: 1px solid var(--border-subtle);
      padding: 2.5rem 2rem;
      text-align: center;
    }

    .footer-text {
      font-size: 0.875rem;
      color: var(--text-muted);
      font-family: var(--font-body);
    }

    .footer-text em {
      font-style: italic;
      color: var(--text-secondary);
    }

    /* ============================================
       RESPONSIVE
       ============================================ */
    @media (max-width: 768px) {
      :root {
        --section-padding: 4rem 1.25rem;
      }

      .hero {
        min-height: auto;
        padding: 6rem 1.25rem 4rem;
      }

      .hero-title {
        font-size: clamp(2.5rem, 10vw, 3.5rem);
      }

      .hero-buttons {
        flex-direction: column;
        align-items: center;
      }

      .btn {
        width: 100%;
        max-width: 300px;
        justify-content: center;
      }

      .modes-grid,
      .parts-grid,
      .concepts-grid,
      .paths-grid {
        grid-template-columns: 1fr;
      }

      .part-card {
        flex-direction: column;
        gap: 0.75rem;
      }

      .cta-section {
        padding: 5rem 1.25rem;
      }
    }

    @media (max-width: 480px) {
      .hero-badge {
        font-size: 0.65rem;
        padding: 0.4rem 1rem;
      }
    }
  </style>
</head>

<body>
  <!-- ============================================
       HERO SECTION
       ============================================ -->
  <section class="hero">
    <!-- Animated SVG network background -->
    <svg class="hero-network" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <!-- Connection lines -->
      <g class="float-group-1">
        <line x1="150" y1="120" x2="320" y2="200" />
        <line x1="320" y1="200" x2="480" y2="150" />
        <line x1="480" y1="150" x2="650" y2="250" />
        <line x1="650" y1="250" x2="820" y2="180" />
        <line x1="820" y1="180" x2="980" y2="280" />
        <line x1="150" y1="120" x2="250" y2="350" />
        <line x1="320" y1="200" x2="400" y2="420" />
        <line x1="480" y1="150" x2="550" y2="380" />
        <line x1="650" y1="250" x2="700" y2="450" />
        <line x1="820" y1="180" x2="900" y2="400" />
      </g>
      <g class="float-group-2">
        <line x1="250" y1="350" x2="400" y2="420" />
        <line x1="400" y1="420" x2="550" y2="380" />
        <line x1="550" y1="380" x2="700" y2="450" />
        <line x1="700" y1="450" x2="900" y2="400" />
        <line x1="250" y1="350" x2="180" y2="550" />
        <line x1="400" y1="420" x2="350" y2="600" />
        <line x1="550" y1="380" x2="600" y2="580" />
        <line x1="700" y1="450" x2="750" y2="620" />
        <line x1="900" y1="400" x2="1000" y2="560" />
      </g>
      <g class="float-group-3">
        <line x1="180" y1="550" x2="350" y2="600" />
        <line x1="350" y1="600" x2="600" y2="580" />
        <line x1="600" y1="580" x2="750" y2="620" />
        <line x1="750" y1="620" x2="1000" y2="560" />
        <line x1="980" y1="280" x2="1050" y2="450" />
        <line x1="1050" y1="450" x2="1000" y2="560" />
        <line x1="100" y1="680" x2="180" y2="550" />
        <line x1="100" y1="680" x2="350" y2="600" />
      </g>

      <!-- Nodes — Layer 1 -->
      <g class="float-group-1">
        <circle cx="150" cy="120" r="3" class="node-blue" />
        <circle cx="320" cy="200" r="4" class="node-purple" />
        <circle cx="480" cy="150" r="3" class="node-green" />
        <circle cx="650" cy="250" r="4" class="node-amber" />
        <circle cx="820" cy="180" r="3" class="node-blue" />
        <circle cx="980" cy="280" r="3" class="node-red" />
      </g>
      <!-- Nodes — Layer 2 -->
